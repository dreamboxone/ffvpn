#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1

start_service() {
	local off='-off'
	local core_dir="$(uci -q get ffvpn.main.core_dir || echo /usr/bin)"
	local core="$core_dir/ffvpn-core"
	[ -x "$core" ] || core=/usr/bin/ffvpn-core
	if [ "$(uci -q get ffvpn.main.enabled)" = 1 ]; then
		off=''
	fi
	procd_open_instance core
	procd_set_param command "$core" -data-dir /etc/ffvpn/core
	[ -n "$off" ] && procd_append_param command "$off"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	/usr/libexec/ffvpn/proxy configure || return 1
	[ "$(uci -q get ffvpn.main.network_enabled)" = 1 ] || return 0
	/usr/libexec/ffvpn/network apply
}

stop_service() {
	/usr/libexec/ffvpn/network restore
	/usr/libexec/ffvpn/proxy stop || true
}
