#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: AGPL-3.0-or-later
USE_PROCD=1

core_path() {
	local directory
	directory=$(uci -q get ffvpn.main.core_dir || echo /usr/bin)
	core="$directory/ffvpn-core"
	[ -x "$core" ] || core=/usr/bin/ffvpn-core
}

start_service() {
	local core lan mtu
	core_path
	"$core" -tun-supported >/dev/null 2>&1 || { echo 'Update the FFVPN core for standalone TUN.' >&2; return 1; }
	lan=$(ubus call network.interface.lan status | jsonfilter -e '@.l3_device')
	case "$lan" in ''|*[!a-zA-Z0-9_.:-]*) echo 'The LAN interface could not be determined.' >&2; return 1;; esac
	mtu=$(uci -q get ffvpn.main.tun_mtu || echo 1500)
	procd_open_instance lan
	procd_set_param command "$core" -lan-tun "$lan" -tun-mtu "$mtu"
	procd_set_param respawn 3600 2 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	local i mtu
	mtu=$(uci -q get ffvpn.main.tun_mtu || echo 1500)
	for i in 1 2 3 4 5 6; do
		if [ "$(cat /var/run/ffvpn-lan-tun.ready 2>/dev/null)" = "$mtu" ] &&
		   [ "$(cat /sys/class/net/ffvpntun/mtu 2>/dev/null)" = "$mtu" ]; then
			return 0
		fi
		sleep 1
	done
	echo 'Standalone TUN did not start. Check kmod-tun and the system log.' >&2
	return 1
}

service_stopped() {
	local core i
	core_path
	# The fallback route can outlive a helper that was killed.
	[ -f /var/run/ffvpn-lan-tun.state ] || return 0
	for i in 1 2 3 4 5; do
		"$core" -tun-cleanup >/dev/null 2>&1 && return 0
		sleep 1
	done
	echo 'Could not remove standalone TUN policy rules.' >&2
	return 1
}
