#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu
umask 077
REPO=https://github.com/dreamboxone/ffvpn
action=${1:-update}
component=${2:-all}
case "$action" in update|reinstall|check) ;; *) exit 2;; esac
case "$component" in all) suffix='' ;; app|core) suffix=".$component";; *) exit 2;; esac
ROOT=${FFVPN_ROOT:-}
core_dir=/usr/bin
if [ -z "$ROOT" ]; then core_dir=$(uci -q get ffvpn.main.core_dir || echo /usr/bin); fi
case "$core_dir" in *..*|*[!a-zA-Z0-9_./-]*) echo 'Invalid core directory.' >&2; exit 1;; esac
case "$core_dir" in /usr/*|/opt/*|/mnt/*|/overlay/*|/tmp/*) ;; *) exit 1;; esac
destination() {
	if [ "$1" = usr/bin/ffvpn-core ] && [ -z "$ROOT" ]; then printf '%s/ffvpn-core\n' "$core_dir"
	else printf '%s/%s\n' "$ROOT" "$1"; fi
}
KEY=${FFVPN_KEY:-$ROOT/usr/share/ffvpn/release.pub}
LOCK=${FFVPN_UPDATE_LOCK:-/var/lock/ffvpn-update}
WORK=$(mktemp -d /tmp/ffvpn-update.XXXXXX)
locked=0
mutated=0
success=0
downloaded=0
reused=0
control_locked=0

rollback() {
	[ "$mutated" = 1 ] || return 0
	while IFS= read -r path; do
		if [ -f "$WORK/backup/$path" ]; then cp -p "$WORK/backup/$path" "$(destination "$path")"
		else rm -f "$(destination "$path")"; fi
	done < "$WORK/touched"
}
cleanup() {
	result=$?
	if [ "$success" != 1 ]; then
		[ "$mutated" != 1 ] || [ -n "$ROOT" ] || /etc/init.d/ffvpn stop || true
		rollback
		[ "$mutated" != 1 ] || [ -n "$ROOT" ] || /etc/init.d/ffvpn start || true
	fi
	rm -r "$WORK"
	[ "$control_locked" != 1 ] || rmdir /var/lock/ffvpn-control
	if [ "$locked" = 1 ]; then
		printf '%s\n' "$result" > /tmp/ffvpn-update.result
		rmdir "$LOCK"
	fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
mkdir "$LOCK" 2>/dev/null || { echo 'Another update is in progress.' >&2; exit 1; }
locked=1
rm -f /tmp/ffvpn-update.result
printf '%s\n%s\n' "$component" "$action" > /tmp/ffvpn-update.job

fetch() {
	case "$1" in https://*|http://127.0.0.1:* ) ;; *) echo 'Untrusted download address.' >&2; return 1;; esac
	echo "Downloading ${1##*/}..." >&2
	# Keep terminal progress separate from the byte count and background logs.
	if [ "${FFVPN_PROGRESS:-0}" = 1 ] || [ -t 2 ]; then
		bytes=$(curl -fL --progress-bar --retry 2 --connect-timeout 15 --max-time 120 --max-filesize 134217728 -w '%{size_download}' "$1" -o "$2")
	else
		bytes=$(curl -fLsS --retry 2 --connect-timeout 15 --max-time 120 --max-filesize 134217728 -w '%{size_download}' "$1" -o "$2")
	fi
	downloaded=$((downloaded + bytes))
}
safe_path() {
	case "$1" in *..*|/*|*[!a-zA-Z0-9_./-]*) return 1;; esac
	case "$1" in
		usr/bin/ffvpn-core|etc/init.d/ffvpn|usr/libexec/ffvpn/*|usr/libexec/rpcd/luci.ffvpn|usr/share/ffvpn/*|usr/share/licenses/ffvpn/*|usr/share/luci/menu.d/luci-app-ffvpn.json|usr/share/rpcd/acl.d/luci-app-ffvpn.json|www/luci-static/resources/ffvpn/*|www/luci-static/resources/view/ffvpn/*) return 0;;
	esac
	return 1
}
verify() { printf '%s  %s\n' "$1" "$2" | sha256sum -c - >/dev/null 2>&1; }
is_release_version() {
	printf '%s\n' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-r[1-9][0-9]*)?$'
}
refuse_downgrade() {
	installed=$(cat "$ROOT/usr/share/ffvpn/$1" 2>/dev/null || true)
	is_release_version "$installed" || return 0
	if awk -v installed="$installed" -v candidate="$2" 'BEGIN {
		gsub(/-r/, ".", installed); gsub(/-r/, ".", candidate);
		split(installed, a, "."); split(candidate, b, ".");
		for (i = 1; i <= 4; i++) {
			if (a[i]+0 != b[i]+0) exit !(a[i]+0 > b[i]+0);
		}
		exit 1;
	}'; then
		printf 'The installed %s (%s) is newer than the published version (%s). Downgrade refused.\n' "$1" "$installed" "$2" >&2
		return 1
	fi
}
finish_file() {
	[ -n "${path:-}" ] || return 0
	[ "$(wc -c < "$WORK/new/$path" | tr -d ' ')" = "$size" ]
	verify "$digest" "$WORK/new/$path"
	chmod "$mode" "$WORK/new/$path"
}

if [ -n "${FFVPN_RELEASE_BASE:-}" ]; then
	base=$FFVPN_RELEASE_BASE
	arch=${FFVPN_ARCH:?}
else
	. /etc/openwrt_release
	arch=$DISTRIB_ARCH
	# Resolve the release without GitHub's rate-limited anonymous API.
	latest=$(curl -fLsSI --retry 2 --connect-timeout 15 --max-time 60 \
		-w '%{url_effective}' -o /dev/null "$REPO/releases/latest")
	case "$latest" in "$REPO/releases/tag/v"[0-9]*) ;; *) echo 'No published FFVPN release.' >&2; exit 1;; esac
	tag=${latest##*/}
	case "$tag" in *[!a-zA-Z0-9._-]*) exit 1;; esac
	base="$REPO/releases/download/$tag"
fi
fetch "$base/$arch.manifest" "$WORK/manifest"
fetch "$base/$arch.manifest.sig" "$WORK/manifest.sig"
usign -V -p "$KEY" -m "$WORK/manifest" -x "$WORK/manifest.sig"
read -r magic schema app_version manifest_arch core_version < "$WORK/manifest"
[ "$magic" = FFVPN ] && [ "$schema" = 2 ] && [ "$manifest_arch" = "$arch" ]
for v in "$app_version" "$core_version"; do
	is_release_version "$v" || { echo 'Invalid signed release version.' >&2; exit 1; }
done
version=$app_version; [ "$component" != core ] || version=$core_version
printf '%s\n' "$app_version" > /tmp/ffvpn-update-app.latest
printf '%s\n' "$core_version" > /tmp/ffvpn-update-core.latest
if [ "$action" = check ]; then
	echo "$version"; success=1; exit 0
fi
if [ "$component" != core ]; then refuse_downgrade version "$app_version"; fi
if [ "$component" != app ]; then refuse_downgrade core-version "$core_version"; fi
archive_record=$(sed -n '2p' "$WORK/manifest")
read -r record archive_hash archive_size archive_name <<EOF
$archive_record
EOF
[ "$record" = A ]
case "$archive_name" in ''|*[!a-zA-Z0-9._-]*|*..*) exit 1;; esac
case "$archive_hash" in ''|*[!0-9a-f]*) exit 1;; esac
[ "${#archive_hash}" = 64 ]
case "$archive_size" in ''|*[!0-9]*) exit 1;; esac
[ "$archive_size" -gt 0 ] && [ "$archive_size" -le 134217728 ]
fetch "$base/$archive_name" "$WORK/release.tar.gz"
echo 'Verifying the archive and extracting component files...'
[ "$(wc -c < "$WORK/release.tar.gz" | tr -d ' ')" = "$archive_size" ]
verify "$archive_hash" "$WORK/release.tar.gz"
mkdir -p "$WORK/new" "$WORK/backup"
: > "$WORK/paths"
: > "$WORK/changed-paths"
: > "$WORK/touched"
total=0
while read -r kind digest mode size path extra; do
    case "$kind" in FFVPN|A) continue;; F) ;; *) exit 1;; esac
    [ -z "${extra:-}" ] && safe_path "$path" || exit 1
    case "$digest" in ''|*[!0-9a-f]*) exit 1;; esac
    [ "${#digest}" = 64 ]
    case "$mode" in 644|755) ;; *) exit 1;; esac
    case "$size" in ''|*[!0-9]*) exit 1;; esac
    [ "$size" -le 67108864 ]
    total=$((total+size)); [ "$total" -le 134217728 ]
    if [ "$component" = core ]; then
        case "$path" in usr/bin/ffvpn-core|usr/share/ffvpn/core-version) ;; *) continue;; esac
    elif [ "$component" = app ]; then
        case "$path" in usr/bin/ffvpn-core|usr/share/ffvpn/core-version) continue;; esac
    fi
    grep -Fxq "$path" "$WORK/paths" && exit 1
    printf '%s\n' "$path" >> "$WORK/paths"
    dest=$(destination "$path")
    part=''; oldIFS=$IFS; IFS=/; set -- ${dest#/}; IFS=$oldIFS
    for segment in "$@"; do part="$part/$segment"; [ ! -L "$part" ] || exit 1; done
    mkdir -p "$WORK/new/${path%/*}"
    tar -xzOf "$WORK/release.tar.gz" "$path" > "$WORK/new/$path"
    finish_file
    printf '%s\n' "$path" >> "$WORK/changed-paths"
done < "$WORK/manifest"
[ -s "$WORK/paths" ]
: > "$WORK/obsolete"
previous="$ROOT/usr/share/ffvpn/installed$suffix.manifest"
if [ ! -f "$previous" ] && [ "$component" != all ]; then previous="$ROOT/usr/share/ffvpn/installed.manifest"; fi
if [ -f "$previous" ]; then
	awk '$1 == "F" {print $5}' "$previous" > "$WORK/previous-paths"
	while IFS= read -r old; do
		safe_path "$old" || exit 1
		if [ "$component" = core ]; then
			case "$old" in usr/bin/ffvpn-core|usr/share/ffvpn/core-version) ;; *) continue;; esac
		elif [ "$component" = app ]; then
			case "$old" in usr/bin/ffvpn-core|usr/share/ffvpn/core-version) continue;; esac
		fi
		if ! grep -Fxq "$old" "$WORK/paths"; then printf '%s\n' "$old" >> "$WORK/obsolete"; fi
	done < "$WORK/previous-paths"
fi
cat "$WORK/changed-paths" "$WORK/obsolete" > "$WORK/all-paths"
echo "Verified ffvpn $version. Installing complete component files."
if [ "$component" != app ]; then
	[ "$(cat "$WORK/new/usr/share/ffvpn/core-version")" = "$core_version" ]
	[ "$("$WORK/new/usr/bin/ffvpn-core" -version)" = "$core_version" ]
fi
# Preserve every prior file until the complete replacement succeeds.
while IFS= read -r path; do
	dest=$(destination "$path")
	if [ -f "$dest" ]; then mkdir -p "$WORK/backup/${path%/*}"; cp -p "$dest" "$WORK/backup/$path"; fi
done < "$WORK/all-paths"
if [ -s "$WORK/all-paths" ]; then
	if [ -z "$ROOT" ]; then
		mkdir /var/lock/ffvpn-control 2>/dev/null || { echo 'A routing operation is in progress.' >&2; exit 1; }
		control_locked=1
		[ "$core_dir" = "$(uci -q get ffvpn.main.core_dir || echo /usr/bin)" ] || { echo 'Core directory changed; retry the update.' >&2; exit 1; }
		uci -q get ffvpn.main.enabled > /tmp/ffvpn-power-target || echo 0 > /tmp/ffvpn-power-target
		[ ! -x /etc/init.d/ffvpn ] || /etc/init.d/ffvpn stop
	fi
	mutated=1
fi
while IFS= read -r path; do
	dest=$(destination "$path")
	mkdir -p "${dest%/*}"
	printf '%s\n' "$path" >> "$WORK/touched"
	cp -p "$WORK/new/$path" "$dest.ffvpn-new"
	mv "$dest.ffvpn-new" "$dest"
done < "$WORK/changed-paths"
while IFS= read -r path; do
	printf '%s\n' "$path" >> "$WORK/touched"
	rm -f "$(destination "$path")"
done < "$WORK/obsolete"
mkdir -p "$ROOT/usr/share/ffvpn"
if [ -z "$ROOT" ] && [ "$mutated" = 1 ]; then
	echo 'Restarting services...'
	/etc/init.d/ffvpn start
	if [ "$component" != core ]; then
		/etc/init.d/rpcd restart
		rm -f /tmp/luci-indexcache
		/etc/init.d/uhttpd reload
	fi
fi
cp "$WORK/manifest" "$ROOT/usr/share/ffvpn/installed$suffix.manifest"
if [ "$component" != core ]; then printf '%s\n' "$version" > "$ROOT/usr/share/ffvpn/version"; fi
if [ "$component" = core ]; then printf '%s\n' "$version" > "$ROOT/usr/share/ffvpn/core-version"; fi
cat "$WORK/paths" >> "$ROOT/usr/share/ffvpn/managed-files"
sort -u "$ROOT/usr/share/ffvpn/managed-files" > "$WORK/managed-files"
cp "$WORK/managed-files" "$ROOT/usr/share/ffvpn/managed-files"
success=1
printf '{"downloaded":%s,"reused":%s}\n' "$downloaded" "$reused" > /tmp/ffvpn-update.stats
echo "Downloaded: $downloaded bytes; complete archive downloaded."
echo "ffvpn $version installed successfully."
